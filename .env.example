# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key - server only, NEVER expose to the browser/client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DaisySMS (from https://daisysms.io/dashboard/profile)
DAISYSMS_API_KEY=your-daisysms-api-key
DAISYSMS_BASE_URL=https://daisysms.io/stubs/handler_api.php

# Used to build absolute URLs (webhook docs, redirects). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret you also paste into a query string on the DaisySMS webhook URL
# e.g. https://yourdomain.com/api/daisy/webhook?secret=THIS_VALUE
# so random internet traffic can't post fake "SMS received" events into your database.
DAISYSMS_WEBHOOK_SECRET=change-me

# PocketFi (from https://pocketfi.ng dashboard -> Settings -> API Keys)
# Used for wallet funding via a permanent dedicated bank account per customer
# — see lib/pocketfi.js and app/(customer)/topup/page.js. Use the sandbox
# base URL below while testing; switch to the live one when you go live.
#
# The dashboard's two keys are named backwards from what you'd expect: use
# the "Public API Key" (LIVE badge, an "id|token" credential) as the Bearer
# token for outbound API calls — that's POCKETFI_PUBLIC_KEY below. The
# "Secret API Key" (CONFIDENTIAL badge, a plain hex string) is NOT a valid
# bearer token at all — it's only used to verify the HMAC-SHA512 signature on
# inbound webhooks (see POCKETFI_WEBHOOK docs / app/api/pocketfi/webhook).
# Using the Secret key as the Bearer token fails every request with
# "Unauthenticated."
POCKETFI_PUBLIC_KEY=your-pocketfi-public-api-key
POCKETFI_SECRET_KEY=your-pocketfi-secret-api-key
POCKETFI_BUSINESS_ID=your-pocketfi-business-id
POCKETFI_BASE_URL=https://api.pocketfi.ng/api/v1
# Sandbox: POCKETFI_BASE_URL=https://api.pocketfi.ng/api/test

# Which bank issues each customer's dedicated virtual account, and whether that
# top-up flow is on at all, are now controlled at /admin/pocketfi (see
# public.pocketfi_config in schema.sql) — not an env var. Nothing to set here.

# Paste this exact URL into PocketFi Dashboard -> Settings -> Webhooks:
# https://yourdomain.com/api/pocketfi/webhook
# The webhook is signed with POCKETFI_SECRET_KEY above (HMAC-SHA512) — no
# separate secret needed for it.

# DaisySim (from https://daisysim.com dashboard -> API) — a second, optional
# numbers provider shown to customers as "International Numbers" (never named
# by brand in customer-facing UI). Kept fully separate from the DaisySMS
# catalog above: different countries/services/prices, own webhook, own
# admin toggle at /admin/international. Off by default until an admin
# switches it on — see daisysim_config in supabase/schema.sql.
DAISYSIM_API_KEY=your-daisysim-api-key
DAISYSIM_BASE_URL=https://daisysim.com/api/v1/virtual

# Optional: shared secret pasted into a query string on the DaisySim webhook
# URL, same convention as DAISYSMS_WEBHOOK_SECRET above (DaisySim's docs
# don't describe a signing scheme, so this is the only guard against fake
# "code received" events).
# e.g. https://yourdomain.com/api/daisysim/webhook?secret=THIS_VALUE
DAISYSIM_WEBHOOK_SECRET=change-me

# DaisySim USA — a THIRD, optional numbers provider ("US Only" to customers).
# A different API/product line from DAISYSIM_API_KEY above — different base
# path ("server7"), USA-only flat catalog, no webhook (polling only via
# GET /check). Kept fully separate: own admin toggle at /admin/us-only, own
# config table (daisysim_usa_config in supabase/schema.sql). Off by default.
DAISYSIM_USA_API_KEY=your-us-only-api-key
DAISYSIM_USA_BASE_URL=https://daisysim.com/api/v1/server7

# iStar (from https://fragmentapi.com dashboard -> API) — a FOURTH, totally
# different kind of provider: not phone-number rentals, Telegram Stars/
# Premium gifting billed from iStar's own TON/USDT wallet, shown to
# customers as "Telegram Premium." Unlike every provider above, its admin
# toggle at /admin/telegram-premium does NOT control customer visibility —
# customers always see "Coming soon" on /products/telegram-premium; only an
# admin can open the real purchase flow to test it. See public.istar_config
# in supabase/schema.sql for why this is deliberate.
#
# Auth is a plain `API-Key` header, NOT `Authorization: Bearer` like every
# other provider here — easy to get wrong if you copy-paste from lib/daisysim.js.
ISTAR_API_KEY=your-istar-api-key
ISTAR_BASE_URL=https://v1.fragmentapi.com/api/v1/partner

# Paste this exact URL into the iStar dashboard -> Webhooks:
# https://yourdomain.com/api/telegram/webhook
# Unlike DaisySMS/DaisySim's query-string-secret convention, iStar SIGNS the
# raw request body with HMAC-SHA256 and sends it in the X-iStar-Signature
# header — set this to whatever secret you configure on their side, and the
# webhook route will reject anything that doesn't verify (no secret set here
# means the webhook route refuses all requests, by design).
ISTAR_WEBHOOK_SECRET=change-me

# Social Boost (from https://thelordofthepanels.com dashboard -> Account) — a
# FIFTH kind of provider: a generic SMM panel (followers/likes/views/comments,
# priced per 1000 units), shown to customers as "Social Boost." Same
# two-switch shape as iStar: its admin toggle at /admin/social-boost does NOT
# control customer visibility — customers always see "Coming soon" on
# /products/social-boost until an admin flips that on separately after
# testing. See public.social_boost_config in supabase/schema.sql. No webhook
# — this panel is poll-only, status is refreshed on demand.
SOCIAL_BOOST_API_KEY=your-social-boost-api-key
SOCIAL_BOOST_API_URL=https://thelordofthepanels.com/api/v2

