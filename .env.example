# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key - server only, NEVER expose to the browser/client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DaisySMS (from https://daisysms.io/dashboard/profile)
DAISYSMS_API_KEY=your-daisysms-api-key
DAISYSMS_BASE_URL=https://daisysms.io/stubs/handler_api.php

# Used to build absolute URLs (webhook docs, redirects). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret you also paste into a query string on the DaisySMS webhook URL
# e.g. https://yourdomain.com/api/daisy/webhook?secret=THIS_VALUE
# so random internet traffic can't post fake "SMS received" events into your database.
DAISYSMS_WEBHOOK_SECRET=change-me

# PocketFi (from https://pocketfi.ng dashboard -> Settings -> API Keys)
# Used for wallet funding via a permanent dedicated bank account per customer
# — see lib/pocketfi.js and app/(customer)/topup/page.js. Use the sandbox
# base URL below while testing; switch to the live one when you go live.
#
# The dashboard shows TWO keys — use the one labeled "Secret API Key"
# (CONFIDENTIAL, hidden by default), NOT "Public API Key" (LIVE, shown in
# plaintext). The public key is for client-side use; using it here instead
# of the secret key will fail every request with "Unauthenticated."
POCKETFI_SECRET_KEY=your-pocketfi-secret-api-key
POCKETFI_BUSINESS_ID=your-pocketfi-business-id
POCKETFI_BASE_URL=https://api.pocketfi.ng/api/v1
# Sandbox: POCKETFI_BASE_URL=https://api.pocketfi.ng/api/test

# Which bank issues each customer's dedicated virtual account. kuda/saveheaven/paga/9psb
# all work without NIN/BVN; palmpay requires both, which NexaVerify doesn't collect.
POCKETFI_VIRTUAL_ACCOUNT_BANK=kuda

# Paste this exact URL into PocketFi Dashboard -> Settings -> Webhooks:
# https://yourdomain.com/api/pocketfi/webhook
# The webhook is signed with POCKETFI_SECRET_KEY above (HMAC-SHA512) — no
# separate secret needed for it.


