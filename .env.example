# Supabase (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key - server only, NEVER expose to the browser/client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# DaisySMS (from https://daisysms.io/dashboard/profile)
DAISYSMS_API_KEY=your-daisysms-api-key
DAISYSMS_BASE_URL=https://daisysms.io/stubs/handler_api.php

# Used to build absolute URLs (webhook docs, redirects). Set to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret you also paste into a query string on the DaisySMS webhook URL
# e.g. https://yourdomain.com/api/daisy/webhook?secret=THIS_VALUE
# so random internet traffic can't post fake "SMS received" events into your database.
DAISYSMS_WEBHOOK_SECRET=change-me


